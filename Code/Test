#define CFG_EU 1
#define LED_PIN     4

#include <lmic.h>
#include <hal/hal.h>
#include <SPI.h>
#include <Wire.h>
#include <SHTSensor.h>
#include <LTR303.h>
#include <Servo.h> 

// --- Configuration des clés TTN (À remplacer par tes clés) ---
static const u4_t DEVADDR = 0x260B0D95;
static const PROGMEM u1_t NWKSKEY[16] = { 0x4C, 0xC8, 0x2C, 0xAF, 0xCD, 0x93, 0x99, 0xE5, 0xD8, 0xCA, 0x8F, 0x87, 0xEA, 0x63, 0x1D, 0xD5 };
static const u1_t PROGMEM APPSKEY[16] = { 0xDA, 0x07, 0x28, 0x55, 0x7B, 0x20, 0x9C, 0xF3, 0xC4, 0x4A, 0xE5, 0xAB, 0x61, 0xE9, 0x91, 0x57 };

void os_getArtEui (u1_t* buf) { }
void os_getDevEui (u1_t* buf) { }
void os_getDevKey (u1_t* buf) { }

static osjob_t sendjob;
const unsigned TX_INTERVAL = 30; // Envoi toutes les 30 secondes

// --- Pin mapping LoRa ---
const lmic_pinmap lmic_pins = {
    .nss = 10,
    .rxtx = LMIC_UNUSED_PIN,
    .rst = 8,
    .dio = {6, 6, 6},
};

// --- Initialisation des capteurs et actionneurs ---
SHTSensor sht;
LTR303 light;
Servo monServo; 

#define SOIL_MOISTURE_PIN A0 
#define SERVO_PIN 5 

unsigned char gain = 0;     
unsigned char integrationTime = 0; 

void onEvent (ev_t ev) {
    if (ev == EV_TXCOMPLETE) {
        Serial.println(F("EV_TXCOMPLETE (Envoi terminé)"));
        
        // Réception et lecture d'un DOWNLINK depuis TTN 
        if (LMIC.dataLen) {
            Serial.print(F("Reçu "));
            Serial.print(LMIC.dataLen);
            Serial.println(F(" octets de Downlink."));
            
            uint8_t downlinkCmd = LMIC.frame[LMIC.dataBeg + 0];
            
            if (downlinkCmd == 0x01) {
                Serial.println(F("Commande TTN : Forcer l'arrosage (LED ON)"));
                digitalWrite(LED_PIN, HIGH);
            } else if (downlinkCmd == 0x00) {
                Serial.println(F("Commande TTN : Stopper l'arrosage (LED OFF)"));
                digitalWrite(LED_PIN, LOW);
            }
        }

        os_setTimedCallback(&sendjob, os_getTime()+sec2osticks(TX_INTERVAL), do_send);
    }
}

void do_send(osjob_t* j){
    if (LMIC.opmode & OP_TXRXPEND) {
        Serial.println(F("OP_TXRXPEND, not sending"));
    } else {
        // --- 1. SIMULATION : Lecture SHT (Température & Humidité) ---
        
        // On commente temporairement la vraie lecture du capteur
        // sht.readSample();
        // float t = sht.getTemperature();
        // float h = sht.getHumidity();

        float t;
        float h;

        // Logique de simulation basée sur le temps (millis)
        if (millis() < 60000) { 
            // Phase 1 : Pendant la première minute (< 60 000 ms)
            t = 32.0; 
            h = 85.0;
            Serial.println(F("\n--- [SIMULATION] PHASE 1 : T=32C, H=85% ---"));
        } else {
            // Phase 2 : Après la première minute
            t = 20.0;
            h = 60.0;
            Serial.println(F("\n--- [SIMULATION] PHASE 2 : T=20C, H=60% ---"));
        }

        // --- 2. Lecture LTR303 (Luminosité) ---
        unsigned int data0, data1;
        double lux = 0.0;
        if (light.getData(data0, data1)) {
            light.getLux(gain, integrationTime, data0, data1, lux);
        }

        // --- 3. Lecture Sol et calcul de l'état ---
        int rawSoil = analogRead(SOIL_MOISTURE_PIN);
        float voltSoil = rawSoil * (3.3 / 1023.0); 
        
        uint8_t etatSol;
        if (voltSoil > 2.1) {
            etatSol = 0; // Trop sec
        } else if (voltSoil > 1.5) { 
            etatSol = 1; // Bien
        } else {
            etatSol = 2; // Trop humide
        }
        
        Serial.print(F("Temp: ")); Serial.print(t);
        Serial.print(F("C | Hum: ")); Serial.print(h);
        Serial.print(F("% | Lux: ")); Serial.print(lux);
        Serial.print(F(" | Sol (V): ")); Serial.print(voltSoil);
        Serial.print(F(" -> Etat: ")); Serial.println(etatSol);

        // --- 4. Logique locale de la LED d'arrosage ---
        if (etatSol == 0 || (etatSol == 1 && t > 27.0)) {
            Serial.println(F("[LED] Condition remplie : Allumage de la LED d'arrosage !"));
            digitalWrite(LED_PIN, HIGH);
        } else {
            digitalWrite(LED_PIN, LOW);
        }

        // --- 5. Logique locale du Servomoteur ---
        int positionActuelle = monServo.read();

        if (t > 30.0 && h > 80.0) {
            if (positionActuelle != 90) { 
                Serial.println(F("[SERVO] Alerte : T > 30 et H > 80 ! Rotation à 90 degrés."));
                monServo.write(90);
            }
        } 
        else if (t <= 25.0 && h < 70.0) {
            if (positionActuelle != 0) { 
                Serial.println(F("[SERVO] Retour au calme : T <= 25 et H < 70. Position initiale (0 degré)."));
                monServo.write(0);
            }
        }

        // --- 6. Formatage des données en octets ---
        int16_t tempInt = (int16_t)(t * 10); 
        uint16_t humInt = (uint16_t)(h * 10);
        uint16_t luxInt = (uint16_t)lux; 

        uint8_t payload[7];
        
        payload[0] = tempInt >> 8;
        payload[1] = tempInt & 0xFF;
        
        payload[2] = humInt >> 8;
        payload[3] = humInt & 0xFF;
        
        payload[4] = luxInt >> 8;
        payload[5] = luxInt & 0xFF;

        payload[6] = etatSol;

        // --- 7. Envoi ---
        LMIC_setTxData2(1, payload, sizeof(payload), 0);
        Serial.println(F("Paquet en file d'attente !"));
    }
}

void setup() {
    Serial.begin(115200);
    Wire.begin(); 
    
    pinMode(LED_PIN, OUTPUT);
    digitalWrite(LED_PIN, LOW); 
    
    monServo.attach(SERVO_PIN);
    monServo.write(0); 
    
    Serial.println(F("Starting..."));
    
    if (sht.init()) {
        Serial.println(F("SHT initialisé."));
    } else {
        Serial.println(F("Erreur SHT !"));
    }

    light.begin();
    light.setControl(gain, false, false);
    light.setMeasurementRate(integrationTime, 3);
    light.setPowerUp();

    os_init();
    LMIC_reset();
    LMIC_setClockError(MAX_CLOCK_ERROR * 2 / 100);

    uint8_t appskey[sizeof(APPSKEY)];
    uint8_t nwkskey[sizeof(NWKSKEY)];
    memcpy_P(appskey, APPSKEY, sizeof(APPSKEY));
    memcpy_P(nwkskey, NWKSKEY, sizeof(NWKSKEY));
    LMIC_setSession (0x1, DEVADDR, nwkskey, appskey);

    #if defined(CFG_EU)
    LMIC_setupChannel(0, 868100000, DR_RANGE_MAP(DR_SF12, DR_SF7),  BAND_CENTI);
    LMIC_setupChannel(1, 868300000, DR_RANGE_MAP(DR_SF12, DR_SF7B), BAND_CENTI);
    LMIC_setupChannel(2, 868500000, DR_RANGE_MAP(DR_SF12, DR_SF7),  BAND_CENTI);
    #endif

    LMIC_setLinkCheckMode(0);
    LMIC.dn2Dr = DR_SF9;
    LMIC_setDrTxpow(DR_SF9, 20);

    do_send(&sendjob);
}

void loop() {
    os_runloop_once();
}
