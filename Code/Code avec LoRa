// --- Fonctions LoRa ---
void onEvent (ev_t ev) {
    if (ev == EV_TXCOMPLETE) {
        Serial.println(F("EV_TXCOMPLETE"));
        os_setTimedCallback(&sendjob, os_getTime()+sec2osticks(TX_INTERVAL), do_send);
    }
}

void do_send(osjob_t* j){
    if (LMIC.opmode & OP_TXRXPEND) {
        Serial.println(F("OP_TXRXPEND, non envoyé"));
    } else {
        // Lecture des capteurs juste avant l'envoi
        sht.readSample();
        currentTemp = sht.getTemperature();
        unsigned int r0, r1;
        if (light.getData(r0, r1)) light.getLux(0, 0, r0, r1, currentLux);
        currentSoilVolt = analogRead(soilPin) * (3.3 / 1023.0);

        // Préparation du Payload (5 octets)
        byte payload[5];
        payload[0] = (int)currentTemp;                   // Temp (ex: 25)
        uint16_t luxSend = (uint16_t)currentLux; 
        payload[1] = luxSend >> 8;                       // Lux High Byte
        payload[2] = luxSend & 0xFF;                     // Lux Low Byte
        payload[3] = (int)(currentSoilVolt * 10);        // Sol (ex: 2.1V -> 21)
        payload[4] = (currentSoilVolt > 2.1) ? 0 : 1;    // Alerte (0: Soif, 1: OK)

        LMIC_setTxData2(1, payload, sizeof(payload), 0);
        Serial.println(F("Paquet capteurs envoyé vers TTN"));
    }
}

void setup() {
    Serial.begin(115200);
    Wire.begin();
    
    // Initialisation Écran et Capteurs
    if(display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
        display.clearDisplay();
        display.display();
    }
    sht.init();
    if (light.begin()) {
        light.setControl(0, false, true);
        light.setMeasurementRate(0, 3);
        light.setPowerUp();
    }

    // Initialisation LoRa
    os_init();
    LMIC_reset();
    LMIC_setClockError(MAX_CLOCK_ERROR * 2 / 100);

    uint8_t appskey[sizeof(APPSKEY)];
    uint8_t nwkskey[sizeof(NWKSKEY)];
    memcpy_P(appskey, APPSKEY, sizeof(APPSKEY));
    memcpy_P(nwkskey, NWKSKEY, sizeof(NWKSKEY));
    LMIC_setSession (0x1, DEVADDR, nwkskey, appskey);

    // Setup Europe 868MHz
    LMIC_setupChannel(0, 868100000, DR_RANGE_MAP(DR_SF12, DR_SF7),  BAND_CENTI);
    LMIC_setupChannel(1, 868300000, DR_RANGE_MAP(DR_SF12, DR_SF7B), BAND_CENTI);
    LMIC_setupChannel(2, 868500000, DR_RANGE_MAP(DR_SF12, DR_SF7),  BAND_CENTI);
    LMIC_setLinkCheckMode(0);
    LMIC.dn2Dr = DR_SF9;
    LMIC_setDrTxpow(DR_SF9, 14);

    do_send(&sendjob);
}

void loop() {
    os_runloop_once(); // Gère LoRa
    updateDisplay();   // Gère l'affichage OLED
}

// Fonction pour l'affichage sans bloquer LoRa
void updateDisplay() {
    static unsigned long lastUpdate = 0;
    static bool toggle = true;
    if (millis() - lastUpdate < 3000) return; // Mise à jour écran toutes les 3s
    lastUpdate = millis();

    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    
    if (toggle) {
        // Mode Smiley
        const unsigned char* bmp = (currentSoilVolt > 2.1) ? img_triste : (currentSoilVolt > 1.8 ? img_neutre : img_sourire);
        display.drawBitmap(52, 8, bmp, 24, 24, SSD1306_WHITE);
        display.setCursor(20, 45);
        display.print(currentSoilVolt); display.print("V - ");
        display.print(currentSoilVolt > 2.1 ? "SOIF" : "OK");
    } else {
        // Mode Mesures
        display.setTextSize(1);
        display.setCursor(0, 0); display.println(F("STATION LORA"));
        display.drawLine(0, 10, 128, 10, SSD1306_WHITE);
        display.setCursor(0, 20); display.setTextSize(2);
        display.print(currentTemp, 1); display.setTextSize(1); display.println(" C");
        display.setCursor(0, 45); display.setTextSize(2);
        display.print((int)currentLux); display.setTextSize(1); display.println(" Lux");
    }
    display.display();
    toggle = !toggle;
}
